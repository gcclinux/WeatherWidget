<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4+ installer definition for Weather Widget.
  Per-user install to AppData\Local\WeatherWidget (no admin required).
  
  IMPORTANT: The Manufacturer value MUST match the legal entity name from your
  Microsoft Partner Center account (Settings > Account settings > Organization profile).
  Replace "Ricardo Wagemaker" below if your Partner Center legal entity name differs.
  
  Build with:
    wix build installer\Package.wxs -d BuildDir=. -d Version=1.0.3 -o WeatherWidget.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Weather Widget"
           Manufacturer="Ricardo Wagemaker"
           Version="$(var.Version)"
           UpgradeCode="E8F4B2A1-7C3D-4E5F-9A1B-2D3E4F5A6B7C"
           Compressed="yes"
           InstallerVersion="500"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Weather Widget is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Install to %LocalAppData%\WeatherWidget (per-user, no admin needed) -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="WeatherWidget">
        <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
          <File Id="WeatherWidgetExe"
                Source="$(var.BuildDir)\weatherwidget.exe"
                KeyPath="yes" />
        </Component>

        <!-- No manual ARP registry entries needed here.
             The icon is set via ARPPRODUCTICON property below, which is the correct
             MSI mechanism for per-user installs. -->
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Weather Widget">
        <Component Id="ApplicationShortcut" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="Weather Widget"
                    Description="Desktop weather widget"
                    Target="[INSTALLFOLDER]weatherwidget.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="WeatherWidgetIcon" />
          <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\WeatherWidget"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Icon for shortcuts and Add/Remove Programs display -->
    <Icon Id="WeatherWidgetIcon" SourceFile="winres\icon.ico" />

    <!-- ARPPRODUCTICON tells Windows which icon to show in Settings > Apps.
         It must reference an Icon element Id defined above. -->
    <Property Id="ARPPRODUCTICON" Value="WeatherWidgetIcon" />

    <Feature Id="ProductFeature" Title="Weather Widget" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <!-- Launch application after install completes (opens settings for first-time setup) -->
    <CustomAction Id="LaunchApplication"
                  FileRef="WeatherWidgetExe"
                  ExeCommand="--settings"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize" Condition="NOT Installed OR NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
